# Copy to .env for local use. .env is gitignored.
# GitHub Actions reads the same names from repository secrets.
# Leave these empty in git. Never commit a real token.

YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REFRESH_TOKEN=

# Optional path for the refresh token the local helper writes. Gitignored
# when left at the default name yahoo_refresh_token. Never commit the file.
# YAHOO_TOKEN_FILE=

# Optional. A token that can update Actions secrets on this repo. The Thursday
# workflow uses it only when Yahoo returns a new refresh token. Without it,
# the new token stays on the runner and is not printed.
# YAHOO_SECRETS_ADMIN_TOKEN=

# Private capture repo Jpidge/gridiron-lab-data. Use one of these, not both.
# DATA_REPO_TOKEN needs contents write on that repo.
# DATA_REPO_DEPLOY_KEY is a write deploy key for that repo.
# DATA_REPO_TOKEN=
# DATA_REPO_DEPLOY_KEY=
