/data/
*.parquet
*.duckdb

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# Model artifacts and evaluation dumps stay out of git.
/artifacts/
*.lgb
